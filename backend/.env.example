PORT=5000
NODE_ENV=production

JWT_SECRET=your-production-jwt-secret

# Supabase PostgreSQL Pooler credentials
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

TATTI_MERCHANT_VPA=tatti.admissions@upi
TATTI_MERCHANT_NAME=Tamil Nadu Advanced Technical Training Institute

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND URL (Used for generating clickable Reset Password links in emails)
# Local dev: http://localhost:5173
# Railway:   https://tattiproject-production-e5af.up.railway.app
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://tattiproject-production-e5af.up.railway.app

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL PROVIDER CONFIGURATION (Choose ONE of Option A, Option B, or Option C)
# ─────────────────────────────────────────────────────────────────────────────

# Option A: Resend.com (Recommended for Railway & production)
# Sign up at https://resend.com, get an API key, and set:
# RESEND_API_KEY=re_123456789abcdef
# EMAIL_FROM="PSY CARE" <no-reply@yourdomain.com>

# Option B: Gmail App Password
# Enable 2FA on Google Account -> Security -> App Passwords -> Create "Psycare Mailer"
# SMTP_SERVICE=gmail
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM="PSY CARE" <your-account@gmail.com>

# Option C: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="PSY CARE" <no-reply@your-domain.com>